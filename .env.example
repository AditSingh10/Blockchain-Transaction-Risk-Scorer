RISK_ENVIRONMENT=local
RISK_LOG_LEVEL=INFO

RISK_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RISK_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
RISK_GRAPH_BATCH_TOPIC=risk.graph-batches.v1
RISK_SCORING_REQUEST_TOPIC=risk.scoring-requests.v1
RISK_SCORING_RESULT_TOPIC=risk.scoring-results.v1
RISK_SCORING_DLQ_TOPIC=risk.scoring-dlq.v1
RISK_GRAPH_BATCH_PARTITIONS=1
RISK_SCORING_REQUEST_PARTITIONS=6
RISK_SCORING_RESULT_PARTITIONS=6
RISK_SCORING_DLQ_PARTITIONS=3

RISK_POSTGRES_DSN=postgresql+asyncpg://risk:risk@postgres:5432/risk
RISK_REDIS_URL=redis://redis:6379/0
RISK_CORS_ORIGINS=["http://localhost:3000"]

RISK_MODEL_PATH=/app/models/gat_resnet_elliptic.pt
RISK_SCALER_PATH=/app/models/scaler.pkl
RISK_MODEL_VERSION=gat-resnet-elliptic-v1
# Optional ISO-8601 deployment timestamp; artifact mtime is used when omitted.
# RISK_MODEL_DEPLOYMENT_TIMESTAMP=2026-07-23T00:00:00Z
RISK_FEATURE_SCHEMA_VERSION=elliptic-165-v1
RISK_ELLIPTIC_DATA_DIR=/data

RISK_REPLAY_EVENTS_PER_SECOND=20
RISK_KAFKA_POLL_TIMEOUT_MS=1000
RISK_KAFKA_MAX_POLL_RECORDS=64
RISK_KAFKA_MAX_MESSAGE_BYTES=67108864
RISK_MAX_IN_FLIGHT_INFERENCE=8
RISK_INFERENCE_BATCH_SIZE=1
RISK_INFERENCE_BATCH_WAIT_MS=0
RISK_RETRY_MAX_ATTEMPTS=4
RISK_RETRY_BASE_DELAY_MS=100
RISK_RETRY_MAX_DELAY_MS=5000

RISK_DATABASE_POOL_SIZE=10
RISK_DATABASE_MAX_OVERFLOW=10
RISK_QUERY_TIMEOUT_MS=1500
RISK_GRAPH_MAX_HOPS=2
RISK_GRAPH_MAX_NODES=100
RISK_GRAPH_MAX_EDGES=500

RISK_REDIS_STREAM_KEY=risk:scoring-results:v1
RISK_REDIS_STREAM_MAXLEN=10000
RISK_REDIS_REPLAY_LIMIT=500
RISK_REDIS_SOCKET_TIMEOUT_SECONDS=2
RISK_WEBSOCKET_CLIENT_QUEUE_SIZE=256
RISK_WEBSOCKET_HEARTBEAT_SECONDS=15
RISK_WEBSOCKET_SEND_TIMEOUT_SECONDS=5
RISK_WEBSOCKET_MAX_MESSAGE_BYTES=4096

RISK_METRICS_PORT=9100
RISK_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces
