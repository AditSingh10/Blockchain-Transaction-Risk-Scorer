{
  "$defs": {
    "GraphBatchPayloadV1": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdgeV1"
          },
          "maxItems": 250000,
          "title": "Edges",
          "type": "array"
        },
        "feature_schema_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Feature Schema Version",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNodeV1"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "source_offset": {
          "minimum": 0,
          "title": "Source Offset",
          "type": "integer"
        },
        "stream_name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Stream Name",
          "type": "string"
        },
        "time_step": {
          "minimum": 1,
          "title": "Time Step",
          "type": "integer"
        }
      },
      "required": [
        "stream_name",
        "time_step",
        "sequence",
        "source_offset",
        "feature_schema_version",
        "nodes"
      ],
      "title": "GraphBatchPayloadV1",
      "type": "object"
    },
    "GraphEdgeV1": {
      "additionalProperties": false,
      "properties": {
        "destination_tx_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Destination Tx Id",
          "type": "string"
        },
        "source_tx_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Source Tx Id",
          "type": "string"
        }
      },
      "required": [
        "source_tx_id",
        "destination_tx_id"
      ],
      "title": "GraphEdgeV1",
      "type": "object"
    },
    "GraphNodeV1": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "items": {
            "type": "number"
          },
          "maxItems": 165,
          "minItems": 165,
          "title": "Features",
          "type": "array"
        },
        "time_step": {
          "minimum": 1,
          "title": "Time Step",
          "type": "integer"
        },
        "tx_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tx Id",
          "type": "string"
        }
      },
      "required": [
        "tx_id",
        "time_step",
        "features"
      ],
      "title": "GraphNodeV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 36,
      "minLength": 36,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "const": "risk.graph-batch.observed.v1",
      "default": "risk.graph-batch.observed.v1",
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/GraphBatchPayloadV1"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "producer": {
      "maxLength": 64,
      "minLength": 2,
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 64,
      "minLength": 16,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "producer",
    "trace_id",
    "correlation_id",
    "payload"
  ],
  "title": "GraphBatchObservedV1",
  "type": "object"
}
